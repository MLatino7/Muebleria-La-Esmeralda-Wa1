---
import SiteLayout from "../layouts/SiteLayout.astro";
import { store } from "../config/store";
import { createWhatsAppUrl } from "../lib/whatsapp";
import { sitePath } from "../lib/paths";
---
<SiteLayout title="Contacto" description="Comunícate con Mueblería La Esmeralda mediante WhatsApp.">
  <section class="page-intro contact-intro"><p class="eyebrow">HABLEMOS</p><h1>¿En qué podemos ayudarte?</h1><p>Consulta los detalles de una pieza o prepara una cotización desde tu carrito.</p>
    <a class="button button-dark" href={createWhatsAppUrl(`Hola, quisiera comunicarme con ${store.name}.`)} target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a>
    <p class="small-note">Se abrirá un mensaje preparado. Debes enviarlo manualmente; no se confirma la recepción de una solicitud.</p>
    <a class="underlined-link" href={sitePath("/catalogo/")}>Volver al catálogo ↗</a>
  </section>
</SiteLayout>
